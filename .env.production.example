# =====================================================================
# ADAPTIVE-PATH Production Environment Configuration Template (.env.production)
# ALL SECRETS MUST BE GENERATED CRYPTOGRAPHICALLY BEFORE DEPLOYMENT
# =====================================================================

APATH_ENVIRONMENT=production
APATH_DEBUG=false
APATH_HOST=0.0.0.0
APATH_PORT=8000
APATH_CORS_ORIGINS=["https://studio.adaptive-path.org","https://api.adaptive-path.org"]

# Production PostgreSQL Database
POSTGRES_USER=apath_db_user
# Generate via: python scripts/generate_secrets.py
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM_PASSWORD_32_CHARS
POSTGRES_DB=adaptive_path_prod
APATH_DATABASE_URL=postgresql://apath_db_user:${POSTGRES_PASSWORD}@postgres:5432/adaptive_path_prod

# Production Redis Cluster
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD_32_CHARS
APATH_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Production MinIO / S3 Object Store
MINIO_ROOT_USER=apath_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STRONG_PASSWORD_32_CHARS
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_LOGS=apath-logs
MINIO_BUCKET_SCENARIOS=apath-scenarios

# Cryptographic Keys (OWASP ASVS Level 2)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(64))"
APATH_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_BASE64_SECRET
APATH_JWT_ALGORITHM=HS256
APATH_ACCESS_TOKEN_EXPIRE_MINUTES=15
APATH_REFRESH_TOKEN_EXPIRE_DAYS=7
APATH_CSRF_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTE_BASE64_CSRF_SECRET

# Security Rate Limiting & Account Protection
APATH_MAX_LOGIN_ATTEMPTS=5
APATH_LOCKOUT_DURATION_SECONDS=900
APATH_RATE_LIMIT_PER_MINUTE=120

# Worker Scale & Resource Allocation
APATH_WORKER_CONCURRENCY=8
APATH_DEFAULT_MAX_CONCURRENT_RUNS=5
APATH_DEFAULT_DAILY_RUN_LIMIT=500
MOCK_MATLAB=0
ENGINE_STRICT_LICENCE=0
RUN_TIMEOUT_S=180
