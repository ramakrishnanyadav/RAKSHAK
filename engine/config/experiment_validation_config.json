{
  "name": "ADAPTIVE-PATH Research Validation Benchmark",
  "version": "1.0.0",
  "protocol": "Pre-registered hypothesis testing and ablation matrix",
  "dataset_splits": {
    "tune": {
      "seeds": [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009],
      "purpose": "Hyperparameter selection & cost weight tuning"
    },
    "validate": {
      "seeds": [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009],
      "purpose": "Model selection & decision rule gate verification"
    },
    "frozen_test": {
      "seeds": [
        3000, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009,
        3010, 3011, 3012, 3013, 3014, 3015, 3016, 3017, 3018, 3019,
        3020, 3021, 3022, 3023, 3024, 3025, 3026, 3027, 3028, 3029
      ],
      "seeds_per_variant": 30,
      "purpose": "Pre-registered frozen evaluation across unobserved seeds"
    }
  },
  "scenarios": [
    "SCENARIO_1_VILLAGE_ROAD",
    "SCENARIO_2_URBAN_INTERSECTION",
    "SCENARIO_3_HIGHWAY_MERGE",
    "SCENARIO_4_DENSE_MARKET",
    "SCENARIO_5_CATTLE_CROSSING"
  ],
  "ablation_planners": [
    {"id": "B0", "name": "Static Shortest Path", "ablation_component": "No obstacle avoidance"},
    {"id": "B1", "name": "Reactive DWA + VO", "ablation_component": "Shortest path + Reactive dynamic window"},
    {"id": "B2", "name": "Hybrid A* Kinematic", "ablation_component": "Kinematic lattice search without forecasting"},
    {"id": "P1", "name": "Nominal Predictive", "ablation_component": "Constant velocity predictions + 1.0s fixed replan"},
    {"id": "P2", "name": "Risk-Aware", "ablation_component": "Conformal prediction envelopes + risk field"},
    {"id": "P3", "name": "Risk-Adaptive", "ablation_component": "Full adaptive replanning trigger + MRM safety envelope"}
  ],
  "hypotheses": {
    "H1": {
      "metric": "collision_rate",
      "test": "McNemar exact paired test",
      "alpha": 0.05,
      "multiple_testing_correction": "Benjamini-Hochberg FDR"
    },
    "H2": {
      "metric": "min_clearance_m",
      "test": "Wilcoxon signed-rank paired test",
      "alpha": 0.05,
      "effect_size": "Rank-biserial correlation & Cohen d"
    },
    "H3": {
      "metric": "max_jerk_m_s3",
      "test": "Wilcoxon signed-rank paired test",
      "alpha": 0.05,
      "direction": "P3 < B1"
    },
    "H4": {
      "metric": "p95_latency_ms",
      "test": "One-sample threshold test",
      "budget_ms": 20.0
    }
  },
  "sensitivity_sweeps": {
    "agent_density": [2, 4, 8, 12, 16],
    "prediction_noise_scale": [0.5, 1.0, 1.5, 2.0, 3.0],
    "detection_dropout_rate": [0.0, 0.05, 0.15, 0.30, 0.50],
    "perception_latency_s": [0.0, 0.05, 0.10, 0.20, 0.35]
  }
}
