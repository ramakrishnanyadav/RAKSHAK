# =====================================================================
# ADAPTIVE-PATH Studio API Configuration Template (.env.example)
# Copy this file to .env and customize secrets before launching in production.
# =====================================================================

# Server Environment: development | testing | production
APATH_ENVIRONMENT=development
APATH_DEBUG=false
APATH_HOST=0.0.0.0
APATH_PORT=8000
APATH_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database & Storage
# For local SQLite portability:
APATH_DATABASE_URL=sqlite:///./adaptive_path.db
# For production PostgreSQL:
# APATH_DATABASE_URL=postgresql://postgres:postgres_secure_pass@postgres:5432/adaptive_path

APATH_STORAGE_DIR=./storage
APATH_REDIS_URL=redis://redis:6379/0

# Cryptography & Security Secrets (OWASP ASVS L2 Compliance)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
APATH_JWT_SECRET=insecure-dev-secret-change-me-in-production-sih2026-apath
APATH_JWT_ALGORITHM=HS256
APATH_ACCESS_TOKEN_EXPIRE_MINUTES=15
APATH_REFRESH_TOKEN_EXPIRE_DAYS=7
APATH_CSRF_SECRET=csrf-insecure-dev-secret-change-me-in-production

# Authentication Rate Limiting & Account Lockout Backoff
APATH_MAX_LOGIN_ATTEMPTS=5
APATH_LOCKOUT_DURATION_SECONDS=300
APATH_RATE_LIMIT_PER_MINUTE=120

# Per-User Resource Quotas
APATH_DEFAULT_MAX_CONCURRENT_RUNS=3
APATH_DEFAULT_DAILY_RUN_LIMIT=100

# Worker Execution & Engine Adapters
APATH_ENGINE_ADAPTER_DEFAULT=python
APATH_WORKER_CONCURRENCY=4
APATH_WORKER_MAX_RETRIES=2
APATH_WORKER_RETRY_BACKOFF_BASE_S=1.0

# Simulation Engine Configurations (MATLAB/RoadRunner, Python, Replay)
MATLAB_BIN=matlab
RUN_TIMEOUT_S=120
ENGINE_STRICT_LICENCE=0
MOCK_MATLAB=0
REPLAY_DELAY_MS=5

# Optional Google OAuth Integration
APATH_GOOGLE_CLIENT_ID=
APATH_GOOGLE_CLIENT_SECRET=
APATH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
